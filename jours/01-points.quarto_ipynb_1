      "source": [
        "#| output: false\n",
        "con.sql(f\"\"\"\n",
        "CREATE TABLE pertes AS\n",
        "WITH derniere AS (\n",
        "    SELECT commune, max(annee) AS derniere\n",
        "    FROM points WHERE geom IS NOT NULL\n",
        "    GROUP BY commune\n",
        ")\n",
        "SELECT d.commune, d.derniere,\n",
        "       arg_max(p.nom_commune, p.annee) AS nom_commune,\n",
        "       arg_max(p.territoire, p.annee) AS territoire,\n",
        "       arg_max(round(ST_X(p.geom), 5), p.annee) AS lon,\n",
        "       arg_max(round(ST_Y(p.geom), 5), p.annee) AS lat\n",
        "FROM derniere d JOIN points p USING (commune)\n",
        "WHERE d.derniere < {ANNEES[-1]}\n",
        "GROUP BY ALL\n",
        "\"\"\")"
