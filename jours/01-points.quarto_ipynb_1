      "source": [
        "# Personnes morales (pmej) > établissements géographiques (ege) > adresses.\n",
        "requete_finess_ans = f\"\"\"CREATE TABLE finess_ans AS\n",
        "WITH pm AS (\n",
        "    SELECT unnest(pmej) AS p\n",
        "    FROM read_json('{SOURCES[\"finess_ans\"]}', columns = {{'pmej': 'JSON[]'}},\n",
        "                   maximum_object_size = 2000000000)\n",
        "),\n",
        "ege AS (SELECT unnest(from_json(p -> '$.ege', '[\"JSON\"]')) AS e FROM pm),\n",
        "adresses AS (\n",
        "    SELECT e ->> '$.informationsGeneralesEGE.numFinessEge' AS finess,\n",
        "           unnest(from_json(e -> '$.adresse', '[\"JSON\"]')) -> '$.coordonneesGeographique' AS c\n",
        "    FROM ege\n",
        ")\n",
        "SELECT finess,\n",
        "       ST_Point(any_value(c ->> '$.coordonneeX')::DOUBLE,\n",
        "                any_value(c ->> '$.coordonneeY')::DOUBLE) AS geom\n",
        "FROM (FROM adresses WHERE c ->> '$.coordonneeX' IS NOT NULL)\n",
        "WHERE finess IN (SELECT FI_ET FROM maternites)\n",
        "GROUP BY finess\"\"\""
      ],
