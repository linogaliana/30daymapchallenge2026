      "source": [
        "#| output: false\n",
        "con.sql(\"\"\"\n",
        "CREATE TABLE points AS\n",
        "SELECT m.annee, m.NOM_MAT AS nom, m.TYPE AS type, m.STATUT AS statut,\n",
        "       m.FI_ET AS finess, m.ACCTOT AS accouchements, p.* EXCLUDE (finess, rang)\n",
        "FROM maternites m LEFT JOIN positions p ON p.finess = m.FI_ET\n",
        "\"\"\")\n",
        "\n",
        "sources = con.sql(\"\"\"\n",
        "SELECT source AS localisation, count(*) AS etablissements\n",
        "FROM positions GROUP BY source ORDER BY min(rang)\n",
        "\"\"\").df()"
