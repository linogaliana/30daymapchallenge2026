        "#| echo: false\n",
        "def apercu_finess(table, colonnes):\n",
        "    \"\"\"Les lignes d'une table FINESS, avec le nom de la maternité pour s'y retrouver.\"\"\"\n",
        "    return con.sql(f\"\"\"\n",
        "    SELECT t.finess, m.nom AS maternite, {colonnes}\n",
        "           round(ST_X(t.geom), 5) AS lon, round(ST_Y(t.geom), 5) AS lat\n",
        "    FROM {table} t\n",
        "    JOIN (SELECT FI_ET, arg_max(NOM_MAT, annee) AS nom FROM maternites GROUP BY FI_ET) m\n",
        "      ON m.FI_ET = t.finess\n",
        "    ORDER BY t.finess\n",
        "    \"\"\").df().to_dict(\"records\")\n",
        "\n",
        "\n",
        "ojs_define(finess_apercu=apercu_finess(\"finess\", \"t.epsg AS projection,\"))"
      ],
