    style: stylePlot,
    projection: {type: "conic-conformal", parallels: [44, 49], rotate: [-3, 0], inset: 6,
                 domain: {type: "Polygon", coordinates: [[[o, s], [o, n], [e, n], [e, s], [o, s]]]}},
    marks: [
      Plot.geo(communesCadrages, {fill: grisNeutre, stroke: fond, strokeWidth: 0.8, clip: "frame"}),
      Plot.dot(visibles, {
        x: "lon", y: "lat", r: cadrage.rayon, fill: (d) => couleurStatut.get(d.statut),
        fillOpacity: 0.85, stroke: fond, strokeWidth: 0.5, clip: "frame"
      }),
      Plot.tip(visibles, Plot.pointer({
        x: "lon", y: "lat", maxRadius: 12,
        title: (d) => `${nomStatut.get(d.statut)} (${d.commune})` +
          (d.nom_res ? `\nRES : ${d.nom_res}` : "") +
          (d.nom_osm ? `\nOSM : ${d.nom_osm}` : d.statut !== "res" ? "\nOSM : (sans nom)" : "") +
          (d.distance !== null ? `\nÉcart : ${entier(d.distance)} m` : "")
      }))
    ]
  })
  return html`<div>${legende}${carte}</div>`
}
